{
  "entities": {
    "UserPublic": {
      "title": "UserPublic",
      "description": "Publicly non-sensitive user profile attributes.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "maxLength": 100 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "createdAt", "updatedAt"]
    },
    "UserPrivate": {
      "title": "UserPrivate",
      "description": "Private PII for a user, isolated from public reads.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 254 },
        "emailVerified": { "type": "boolean" },
        "phoneNumber": { "type": "string", "maxLength": 30 },
        "deliveryAddress": { "type": "string", "maxLength": 300 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "emailVerified", "updatedAt"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Authorized admin record keyed by Firebase Auth UID.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "maxLength": 254 },
        "addedBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "addedBy", "createdAt"]
    },
    "Order": {
      "title": "Order",
      "description": "A user's purchase order.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userEmail": { "type": "string", "maxLength": 254 },
        "items": {
          "type": "array",
          "maxLength": 50
        },
        "total": { "type": "number" },
        "currency": { "type": "string", "enum": ["BDT", "USD"], "maxLength": 10 },
        "shippingZone": { "type": "string", "enum": ["inside", "outside"], "maxLength": 20 },
        "deliveryAddress": { "type": "string", "minLength": 5, "maxLength": 300 },
        "phoneNumber": { "type": "string", "minLength": 6, "maxLength": 30 },
        "paymentMethod": { "type": "string", "enum": ["card", "bkash"], "maxLength": 20 },
        "status": {
          "type": "string",
          "enum": ["wait_sending", "partial_sending", "completed", "refunded", "cancelled"],
          "maxLength": 30
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "userEmail",
        "items",
        "total",
        "currency",
        "shippingZone",
        "deliveryAddress",
        "phoneNumber",
        "paymentMethod",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "Review": {
      "title": "Review",
      "description": "A customer review for a product.",
      "type": "object",
      "properties": {
        "productId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "rating": { "type": "number" },
        "comment": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["productId", "userId", "userName", "rating", "comment", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserPublic" },
      "description": "User public profile record."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivate" },
      "description": "User private PII isolated from other users."
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/Admin" },
      "description": "Authorized admin UIDs."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Orders placed by verified users."
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Product reviews authored by verified users."
    }
  }
}
