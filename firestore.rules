rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1 / Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'rexafrfr@gmail.com'
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Validation Blueprints (Anti-Update-Gap) ---
    function isValidUserPublic(data) {
      return data.keys().hasAll(['uid', 'displayName', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['uid', 'displayName', 'photoURL', 'createdAt', 'updatedAt']) &&
             data.uid is string && isValidId(data.uid) &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100 &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    function isValidUserPrivate(data) {
      return data.keys().hasAll(['email', 'emailVerified', 'updatedAt']) &&
             data.keys().hasOnly(['email', 'emailVerified', 'phoneNumber', 'deliveryAddress', 'updatedAt']) &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 254 &&
             data.emailVerified is bool &&
             (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 30)) &&
             (!('deliveryAddress' in data) || (data.deliveryAddress is string && data.deliveryAddress.size() <= 300)) &&
             data.updatedAt is timestamp;
    }

    function isValidAdmin(data) {
      return data.keys().hasAll(['uid', 'email', 'addedBy', 'createdAt']) &&
             data.keys().hasOnly(['uid', 'email', 'addedBy', 'createdAt']) &&
             data.uid is string && isValidId(data.uid) &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 254 &&
             data.addedBy is string && isValidId(data.addedBy) &&
             data.createdAt is timestamp;
    }

    function isValidOrder(data) {
      return data.keys().hasAll([
               'userId', 'userEmail', 'items', 'total', 'currency',
               'shippingZone', 'deliveryAddress', 'phoneNumber',
               'paymentMethod', 'status', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'userId', 'userEmail', 'items', 'total', 'currency',
               'shippingZone', 'deliveryAddress', 'phoneNumber',
               'paymentMethod', 'status', 'createdAt', 'updatedAt'
             ]) &&
             data.userId is string && isValidId(data.userId) &&
             data.userEmail is string && data.userEmail.size() > 0 && data.userEmail.size() <= 254 &&
             data.items is list && data.items.size() > 0 && data.items.size() <= 50 &&
             data.items[0] is map &&
             data.items[0].id is string && data.items[0].id.size() > 0 && data.items[0].id.size() <= 128 &&
             data.items[0].name is string && data.items[0].name.size() > 0 && data.items[0].name.size() <= 200 &&
             data.items[0].price is number && data.items[0].price > 0 &&
             data.items[0].quantity is number && data.items[0].quantity >= 1 && data.items[0].quantity <= 50 &&
             data.total is number && data.total > 0 && data.total <= 1000000 &&
             data.currency is string && data.currency in ['BDT', 'USD'] &&
             data.shippingZone is string && data.shippingZone in ['inside', 'outside'] &&
             data.deliveryAddress is string && data.deliveryAddress.size() >= 5 && data.deliveryAddress.size() <= 300 &&
             data.phoneNumber is string && data.phoneNumber.size() >= 6 && data.phoneNumber.size() <= 30 &&
             data.paymentMethod is string && data.paymentMethod in ['card', 'bkash'] &&
             data.status is string && data.status in ['wait_sending', 'partial_sending', 'completed', 'refunded', 'cancelled'] &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    function isValidReview(data) {
      return data.keys().hasAll(['productId', 'userId', 'userName', 'rating', 'comment', 'createdAt']) &&
             data.keys().hasOnly(['productId', 'userId', 'userName', 'rating', 'comment', 'createdAt']) &&
             data.productId is string && isValidId(data.productId) &&
             data.userId is string && isValidId(data.userId) &&
             data.userName is string && data.userName.size() > 0 && data.userName.size() <= 100 &&
             data.rating is number && data.rating >= 1 && data.rating <= 5 &&
             data.comment is string && data.comment.size() >= 1 && data.comment.size() <= 2000 &&
             data.createdAt is timestamp;
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isOwner(userId) &&
                    isValidId(userId) &&
                    isValidUserPublic(incoming()) &&
                    incoming().uid == request.auth.uid &&
                    incoming().createdAt == request.time &&
                    incoming().updatedAt == request.time;
      allow update: if isOwner(userId) &&
                    isValidId(userId) &&
                    isValidUserPublic(incoming()) &&
                    incoming().uid == existing().uid &&
                    incoming().createdAt == existing().createdAt &&
                    incoming().updatedAt == request.time &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt']);
      allow delete: if false;

      match /private/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && (isOwner(userId) || isAdmin());
        allow list: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId) &&
                              isValidId(userId) &&
                              docId == 'info' &&
                              isValidUserPrivate(incoming()) &&
                              incoming().email == request.auth.token.email &&
                              incoming().emailVerified == request.auth.token.email_verified &&
                              incoming().updatedAt == request.time;
        allow delete: if false;
      }
    }

    match /admins/{adminUid} {
      allow get: if isSignedIn() && isValidId(adminUid) && (request.auth.uid == adminUid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin() &&
                            isValidId(adminUid) &&
                            isValidAdmin(incoming()) &&
                            incoming().uid == adminUid &&
                            incoming().addedBy == request.auth.uid &&
                            incoming().createdAt == request.time;
      allow delete: if isAdmin() && isValidId(adminUid) && adminUid != request.auth.uid;
    }

    match /orders/{orderId} {
      allow get: if isSignedIn() && isValidId(orderId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
                    isValidId(orderId) &&
                    isValidOrder(incoming()) &&
                    incoming().userId == request.auth.uid &&
                    incoming().userEmail == request.auth.token.email &&
                    incoming().status == 'wait_sending' &&
                    incoming().createdAt == request.time &&
                    incoming().updatedAt == request.time;
      allow update: if isSignedIn() &&
                    isValidId(orderId) &&
                    isValidOrder(incoming()) &&
                    incoming().userId == existing().userId &&
                    incoming().userEmail == existing().userEmail &&
                    incoming().items == existing().items &&
                    incoming().total == existing().total &&
                    incoming().currency == existing().currency &&
                    incoming().shippingZone == existing().shippingZone &&
                    incoming().deliveryAddress == existing().deliveryAddress &&
                    incoming().phoneNumber == existing().phoneNumber &&
                    incoming().paymentMethod == existing().paymentMethod &&
                    incoming().createdAt == existing().createdAt &&
                    incoming().updatedAt == request.time &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) && (
                      (
                        existing().userId == request.auth.uid &&
                        existing().status == 'wait_sending' &&
                        incoming().status == 'cancelled'
                      ) ||
                      isAdmin()
                    );
      allow delete: if false;
    }

    match /reviews/{reviewId} {
      allow get, list: if true;
      allow create: if isSignedIn() &&
                    isValidId(reviewId) &&
                    isValidReview(incoming()) &&
                    incoming().userId == request.auth.uid &&
                    incoming().createdAt == request.time;
      allow update: if isSignedIn() &&
                    isValidId(reviewId) &&
                    isValidReview(incoming()) &&
                    existing().userId == request.auth.uid &&
                    incoming().userId == existing().userId &&
                    incoming().productId == existing().productId &&
                    incoming().createdAt == existing().createdAt &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['rating', 'comment', 'userName']);
      allow delete: if isSignedIn() && isValidId(reviewId) && (existing().userId == request.auth.uid || isAdmin());
    }
  }
}
